          <alias key='&quot;[federated.0u9kv8e03gwq1n1c20npx0zwl85r].[sum:Calculation_3803008459050860555:qk]&quot;' value='Latest Paid Loss' />
        </aliases>
      </column>
      <column caption='Accident Year' datatype='integer' name='[AccidentYear]' role='dimension' type='ordinal' />
      <column caption='Bulk Loss' datatype='integer' name='[BulkLoss]' role='measure' type='quantitative' />
      <column aggregation='Sum' caption='Calender Year' datatype='integer' name='[Calculation_3803008459008389120]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='[AccidentYear] + [DevelopmentLag] - 1' />
      </column>
      <column caption='Loss Ratio' datatype='real' name='[Calculation_3803008459012292609]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([IncurredLosses]) / SUM([EarnedPremNet])' />
      </column>
      <column caption='text' datatype='string' name='[Calculation_3803008459026010118]' role='measure' type='nominal'>
        <calculation class='tableau' formula='ATTR([GRNAME])&#13;&#10;+ &quot; generated $&quot;&#13;&#10;+ STR(ROUND(SUM([EarnedPremNet]) / 1000000, 1))&#13;&#10;+ &quot;M in earned premium with a &quot;&#13;&#10;+ STR(ROUND((SUM([IncurredLosses]) / SUM([EarnedPremNet])) * 100, 1))&#13;&#10;+ &quot;% loss ratio.&quot;' />
      </column>
      <column caption='Age-to-Age Development Factor' datatype='real' name='[Calculation_3803008459042410503]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([CumPaidLoss])&#13;&#10;/&#13;&#10;LOOKUP(SUM([CumPaidLoss]), -1)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Cumulative paid loss %' datatype='real' name='[Calculation_3803008459047637001]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([CumPaidLoss])&#13;&#10;/&#13;&#10;WINDOW_MAX(SUM([CumPaidLoss]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Latest Cumulative Paid Loss' datatype='integer' name='[Calculation_3803008459050860555]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [DevelopmentLag] =&#13;&#10;   { FIXED [AccidentYear] : MAX([DevelopmentLag]) }&#13;&#10;THEN [CumPaidLoss]&#13;&#10;END' />
      </column>
      <column caption='Latest Posted Reserves' datatype='real' name='[Calculation_3803008459051331596]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [DevelopmentLag] =&#13;&#10;   { FIXED [AccidentYear] : MAX([DevelopmentLag]) }&#13;&#10;THEN [PostedReserves2007]&#13;&#10;END' />
      </column>
      <column caption='Latest Age-to-Age Factor' datatype='real' name='[Calculation_3803008459051393037]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [DevelopmentLag] =&#13;&#10;   { FIXED [AccidentYear] : MAX([DevelopmentLag]) }&#13;&#10;THEN&#13;&#10;    [CumPaidLoss]&#13;&#10;    /&#13;&#10;    { FIXED [AccidentYear] :&#13;&#10;        MAX(&#13;&#10;            IF [DevelopmentLag] =&#13;&#10;               { FIXED [AccidentYear] : MAX([DevelopmentLag]) } - 1&#13;&#10;            THEN [CumPaidLoss]&#13;&#10;            END&#13;&#10;        )&#13;&#10;    }&#13;&#10;END' />
      </column>
      <column caption='Latest Development Lag' datatype='integer' name='[Calculation_3803008459051794446]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [AccidentYear] : MAX([DevelopmentLag]) }' />
      </column>
      <column caption='age to age factor fixed' datatype='real' name='[Calculation_3803008459054374927]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [DevelopmentLag] =&#13;&#10;   { FIXED [AccidentYear] : MAX([DevelopmentLag]) }&#13;&#10;THEN&#13;&#10;    [CumPaidLoss]&#13;&#10;    /&#13;&#10;    { FIXED [AccidentYear] :&#13;&#10;        MAX(&#13;&#10;            IF [DevelopmentLag] =&#13;&#10;               { FIXED [AccidentYear] : MAX([DevelopmentLag]) } - 1&#13;&#10;            THEN [CumPaidLoss]&#13;&#10;            END&#13;&#10;        )&#13;&#10;    }&#13;&#10;END' />
      </column>
      <column caption='Cumulative Paid Loss' datatype='integer' name='[CumPaidLoss]' role='measure' type='quantitative' />
